+	/**
+	 * Deletes leftover item rows of sold broker lots (the goods of a sale to a virtual buyer stay in the broker location until the seller collects
+	 * the Kinah). Only rows still in the broker location are deleted, so an item that moved to a real buyer is never touched.
+	 */
+	public static void deleteBrokerLocationItems(Collection<Integer> itemUniqueIds) {
+		if (itemUniqueIds.isEmpty())
+			return;
+		try (Connection con = DatabaseFactory.getConnection();
+				 PreparedStatement stmt = con.prepareStatement("DELETE FROM inventory WHERE item_unique_id=? AND item_location=?")) {
+			for (int id : itemUniqueIds) {
+				stmt.setInt(1, id);
+				stmt.setInt(2, StorageType.BROKER.getId());
+				stmt.addBatch();
+			}
+			stmt.executeBatch();
+		} catch (Exception e) {
+			log.error("Error deleting leftover broker items " + itemUniqueIds, e);
+		}
+	}
