+	// ---- broker simulation hooks ----
+
+	public void addSimulatedListing(BrokerItem brokerItem) {
+		synchronized (this) {
+			Map<Integer, BrokerItem> map = brokerItem.getItemBrokerRace() == BrokerRace.ELYOS ? elyosBrokerItems : asmodianBrokerItems;
+			map.put(brokerItem.getItemUniqueId(), brokerItem);
+		}
+	}
+
+	public boolean removeSimulatedListing(Race race, int itemUniqueId) {
+		synchronized (this) {
+			Map<Integer, BrokerItem> map = getRaceBrokerItems(race);
+			BrokerItem brokerItem = map == null ? null : map.get(itemUniqueId);
+			if (brokerItem == null || !BrokerSimulationService.isSimulatedSeller(brokerItem.getSellerId()))
+				return false; // never touch a real player's listing
+			map.remove(itemUniqueId);
+			return true;
+		}
+	}
+
+	/** Snapshot of the REAL players' listings of one faction (virtual traders excluded). */
+	public List<BrokerItem> getPlayerListings(Race race) {
+		Map<Integer, BrokerItem> map = getRaceBrokerItems(race);
+		if (map == null)
+			return List.of();
+		return map.values().stream()
+			.filter(b -> b != null && b.getItem() != null && !b.isSold() && !b.isCanceled() && !BrokerSimulationService.isSimulatedSeller(b.getSellerId()))
+			.collect(Collectors.toList());
+	}
+
+	/**
+	 * A virtual buyer buys {@code count} pieces of a real player's listing. The seller is settled exactly like after a normal sale (sold entry,
+	 * settled-icon, Kinah collectable at the broker NPC). The goods simply disappear; they never enter anybody's inventory.
+	 *
+	 * @return true if the sale happened
+	 */
+	public boolean sellToSimulatedBuyer(Race race, int itemUniqueId, long count) {
+		synchronized (this) {
+			Map<Integer, BrokerItem> map = getRaceBrokerItems(race);
+			BrokerItem listing = map == null ? null : map.get(itemUniqueId);
+			if (listing == null || listing.getItem() == null || listing.isSold() || listing.isCanceled()
+				|| BrokerSimulationService.isSimulatedSeller(listing.getSellerId()))
+				return false;
+			if (count <= 0 || count > listing.getItemCount())
+				return false;
+
+			BrokerItem soldLot;
+			if (count < listing.getItemCount()) {
+				if (!listing.isSplittingAvailable())
+					return false;
+				Item soldItem = ItemFactory.newItem(listing.getItemId(), count);
+				if (soldItem == null)
+					return false;
+				soldItem.setItemLocation(StorageType.BROKER.getId()); // never an inventory location, so it can't show up in anyone's bag
+				// remaining part stays listed
+				listing.decreaseItemCount(count);
+				listing.setPersistentState(PersistentState.UPDATE_REQUIRED);
+				saveManager.add(new BrokerOpSaveTask(listing, listing.getItem(), null, listing.getSellerId()));
+				soldLot = new BrokerItem(soldItem, listing.getPrice(), listing.getSellerId(), listing.isSplittingAvailable(), listing.getItemBrokerRace());
+			} else {
+				map.remove(itemUniqueId);
+				soldLot = listing;
+			}
+			putToSettled(race, soldLot, true);
+			leftoverItemRows.add(soldLot.getItemUniqueId());
+
+			if (LoggingConfig.LOG_BROKER_EXCHANGE)
+				log.info("[sim buyer] bought item " + soldLot.getItemId() + " (count: " + count + ") from player: "
+					+ PlayerService.getPlayerName(soldLot.getSellerId()) + " (total price: " + soldLot.getPrice() * count + ")");
+			return true;
+		}
+	}
+
+	/** Lowest price per piece of every item currently listed in a faction's broker (virtual traders included). */
+	public Map<Integer, Long> getLowestPrices(Race race) {
+		Map<Integer, Long> lowest = new HashMap<>();
+		Map<Integer, BrokerItem> map = getRaceBrokerItems(race);
+		if (map != null)
+			for (BrokerItem b : map.values())
+				if (b != null && b.getItem() != null && !b.isSold() && !b.isCanceled())
+					lowest.merge(b.getItemId(), b.getPrice(), Math::min);
+		return lowest;
+	}
+
+	public boolean isListed(Race race, int itemUniqueId) {
+		Map<Integer, BrokerItem> map = getRaceBrokerItems(race);
+		return map != null && map.containsKey(itemUniqueId);
+	}
+
+	private static String getSellerName(int sellerId) {
+		return PlayerService.getPlayerName(sellerId);
+	}
